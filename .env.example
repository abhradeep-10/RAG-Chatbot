# Ollama (default):  ollama pull qwen2.5:7b-instruct
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_MODEL=qwen2.5:7b-instruct
RAG_LLM_API_KEY=not-needed-for-ollama


# --- Embeddings / reranker (downloaded from Hugging Face on first run) ---
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_USE_RERANKER=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_DEVICE=cpu

RAG_INDEX_DIR=data/indexes
RAG_LOG_LEVEL=INFO
